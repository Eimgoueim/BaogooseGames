; Godot 原生迁移工程。主场景是界面与输入迁移预览，完整玩法仍在迁移。
config_version=5

[application]
config/name="Baogoose Games"
run/main_scene="res://scenes/native_room.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1120
window/size/viewport_height=960
window/size/window_width_override=1120
window/size/window_height_override=960
window/size/min_width=320
window/size/min_height=300
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
